# Copie este arquivo para ".env" e preencha com as credenciais reais.
# NUNCA commite o arquivo ".env" (ele já está no .gitignore).

# Servidor SMTP usado para o envio dos e-mails aos clientes
SMTP_HOST=smtp.seudominio.com.br
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USER=clientes.backup@coretiexpert.com.br
SMTP_PASSWORD=coloque-a-senha-ou-app-password-aqui

# Remetente exibido nos e-mails
SMTP_FROM_EMAIL=clientes.backup@coretiexpert.com.br
SMTP_FROM_NAME=Core TI Expert - Departamento de Backup

# Chave de cifragem (Fernet) usada para proteger a senha SMTP salva em
# settings.json. NÃO precisa ser preenchida manualmente: é gerada
# automaticamente na primeira vez que as configurações são salvas via
# /api/settings e persistida aqui pelo próprio backend.
# SETTINGS_ENC_KEY=
